# ============================================================
#  BK_EQ_Hybrid · 行尾与二进制处理
#  本机 core.autocrlf=true，若不锁定会在跨机器/跨平台时产生
#  整文件换行差异。这里显式声明，保证仓库内一律 LF。
# ============================================================

# 默认：文本文件入库统一 LF
* text=auto eol=lf

# ---- 明确的文本类型 ----
*.md        text eol=lf
*.txt       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.py        text eol=lf
*.ps1       text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.gitignore text eol=lf
.gitattributes text eol=lf

# ---- 二进制：禁止任何转换 ----
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.psd       binary
*.pdf       binary
*.docx      binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.mid       binary
*.vst3      binary

# ---- 语言统计：素材与文档不计入 ----
*.png       linguist-documentation
*.pdf       linguist-documentation
docs/**     linguist-documentation
